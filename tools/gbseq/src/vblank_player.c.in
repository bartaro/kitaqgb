// Generated for one Game Boy. Compile one part per player.
#include "audio_vblank.h"
#include "music.h"
#pragma fixed_bank 0
void AudioVBlank_QueueReset();
u8 __stackcall AudioVBlank_QueueRefill(const u8 *records, u8 count);
u8 AudioVBlank_QueuePlay();
@DECL@
__wram u8 vb_bank;
__wram u16 vb_offset;
__wram u8 vb_done;
__wram u8 vb_buffer[80];
void GbseqVB_Pump() {
    u8 space;
    u8 got;
    u8 i;
    u16 size;
    const u8 *src;
    while (vb_done == 0 && AudioVBlank_QueueCount < 16) {
        src = 0;
        size = 0;
@CASES@
        if (src == 0) return;
        space = (u8)(16 - AudioVBlank_QueueCount);
        if ((u16)(space * 5) > (u16)(size - vb_offset))
            space = (u8)((size - vb_offset) / 5);
        __farmemcpy(vb_buffer, vb_bank, src + vb_offset, (u16)(space * 5));
#ifndef AUDIO_VBLANK_STANDARD_INST_ORDER
        // Old public drivers use noise=2 and wave=3 in SET_INST only.
        // Stored song bytes always use the physical audio.h order.
        for (i=0; i<(u8)(space*5); i+=5) {
            if (vb_buffer[i]==0xFC && vb_buffer[i+1]==0x11 && vb_buffer[i+2]>=2)
                vb_buffer[i+2]= (u8)(vb_buffer[i+2] ^ 1);
        }
#endif
        got = AudioVBlank_QueueRefill(vb_buffer, space);
        if (got == 0) return;
        vb_offset += (u16)(got * 5);
        if (vb_offset == size) {
            vb_offset = 0;
            if (vb_bank == @LAST@) { @REPEAT@ }
            else vb_bank++;
        }
    }
}
void GbseqVB_Start() {
    AudioVBlank_QueueReset();
    vb_bank = 2;
    vb_offset = 0;
    vb_done = 0;
    GbseqVB_Pump();
    AudioVBlank_QueuePlay();
}
